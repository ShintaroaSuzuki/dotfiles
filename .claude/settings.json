{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/shintaro/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx ccusage statusline"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "codex-collaborator@shintaroazusuki-plugins": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "commit-commands@shintaroazusuki-plugins": true,
    "context7@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "elevator-music@sevii-agent-marketplace": false,
    "example-skills@anthropic-agent-skills": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "frontend-design@shintaroazusuki-plugins": true,
    "hookify@claude-plugins-official": true,
    "mgrep@Mixedbread-Grep": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-wiggum@claude-code-plugins": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ux-concepts@shintaroazusuki-plugins": true,
    "ux_concepts@shintaroazusuki-plugins": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "model": "claude-fable-5[1m]"
}
