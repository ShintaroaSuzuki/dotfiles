COLLIE_TRUSTED_USER=shintaro.suzuki1221@gmail.com
COLLIE_PORT=9876
COLLIE_HOST=127.0.0.1
COLLIE_POLL_MS=1500
COLLIE_READ_LINES=200
COLLIE_SUBMIT_KEYS=Enter
COLLIE_MUX=herdr

# Web Push の鍵は、このテンプレートを .env にコピーしてから `collie push-keys` で生成する。
# 生成された秘密鍵を、この Git 管理下のテンプレートへ追加しないこと。
# COLLIE_VAPID_PUBLIC=
# COLLIE_VAPID_PRIVATE=
# COLLIE_VAPID_SUBJECT=mailto:you@example.com
